# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database
POSTGRES_PASSWORD=your_postgres_password_here

# API Keys for Data Sources
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Agent API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key  # Optional, if using OpenAI

# HuggingFace (if using private models)
HUGGINGFACE_TOKEN=your_huggingface_token  # Optional

# Tinker API (for validation)
TINKER_API_KEY=your_tinker_api_key
